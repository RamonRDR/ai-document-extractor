# Copy to .env for local reference. Export variables before running the server.
# Demo mode works with no secrets and makes NO model calls.
ALLOW_PAID_AI=0
OPENAI_API_KEY=
AI_MODEL=gpt-4o-mini
AI_TIMEOUT_SECONDS=20
MAX_UPLOAD_BYTES=5242880
MAX_BATCH_FILES=5
# Optional USD per million tokens for a live evaluation cost estimate.
AI_INPUT_USD_PER_MILLION=0
AI_OUTPUT_USD_PER_MILLION=0
# Optional manual 30-case model evaluation; NEVER enabled by CI.
EVAL_LIVE=0
